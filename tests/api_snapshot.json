    "sweep_modes": {"parameters": ["fiber", "parameters", "modes", "parameter_name", "setter", "metrics", "families", "max_nu", "max_m"], "defaults": {"modes": null, "parameter_name": "wavelength", "setter": null, "metrics": ["effective_index", "propagation_constant"], "families": ["LP"], "max_nu": 6, "max_m": 6}},
    "optimize_fiber": {"parameters": ["fiber", "parameters", "objective", "constraints", "method", "penalty", "options"], "defaults": {"constraints": [], "method": "differential_evolution", "penalty": 1000000000000.0, "options": null}},
    "overlap": {"parameters": ["field_a", "field_b", "normalized"], "defaults": {"normalized": true}},
    "coupling_matrix": {"parameters": ["fields", "perturbation"], "defaults": {"perturbation": null}},
    "Fiber.get_effective_index": {"parameters": ["self", "mode"], "defaults": {}},
    "Fiber.solve_effective_index": {"parameters": ["self", "mode"], "defaults": {}},
    "Fiber.get_mode_field": {"parameters": ["self", "mode", "limit", "n_point"], "defaults": {"limit": null, "n_point": 101}}
  }
